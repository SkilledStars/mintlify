  "paths": {
    "/api/v1/marketing-results": {
      "get": {
        "summary": "Get marketing results data",
        "description": "Retrieves categorized marketing data based on the specified target field",
        "parameters": [
          {
            "name": "dataTag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The data tag to filter results (marketing tag)"
          },
          {
            "name": "target_field",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "adAffinities",
                "adTopics",
                "adInMarketAffinities",
                "keywords"
              ]
            },
            "description": "The type of marketing data to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "target_name": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "occurrence_count": {
                        "type": "integer"
                      },
                      "weighted_relevance": {
                        "type": "number"
                      },
                      "avg_exclusion_score": {
                        "type": "number"
                      },
                      "all_defenses": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "Sample Output": {
                    "value": [
                      {
                        "target_name": "food & dining>fast food cravers",
                        "id": "92900",
                        "occurrence_count": 7,
                        "weighted_relevance": 9.285714285714286,
                        "avg_exclusion_score": 0.41582344259534565,
                        "all_defenses": [
                          "This affinity targets individuals who enjoy fast food, aligning with Wendy's target audience.",
                          "This affinity directly targets Wendy's lovers who frequently consume fast food, making it highly relevant.",
                          "This affinity directly targets Wendy's core audience, ensuring high relevance for the campaign.",
                          "This affinity targets fast food lovers, aligning with Wendy's target audience.",
                          "This affinity directly targets individuals who frequently consume fast food, aligning perfectly with Wendy's target audience."
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/channel-count": {
      "get": {
        "summary": "Get channel counts",
        "description": "Retrieve filtered and original channel counts based on date range, keywords, and other parameters.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date for the data range (YYYY-MM-DD)"
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date for the data range (YYYY-MM-DD)"
          },
          {
            "name": "keywords",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Keywords to filter the data"
          },
          {
            "name": "requireAll",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "description": "Whether to require all keywords"
          },
          {
            "name": "dataTag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Data tag for filtering (audience tag)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filteredCount": {
                      "type": "integer"
                    },
                    "originalCount": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "filteredCount": 1,
                  "originalCount": 1
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
