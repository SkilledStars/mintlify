    "/api/v1/video-count": {
      "get": {
        "summary": "Get video counts",
        "description": "Retrieve filtered and original video counts based on date range, keywords, and other parameters.",
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date for the data range (YYYY-MM-DD)"
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date for the data range (YYYY-MM-DD)"
          },
          {
            "name": "keywords",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Keywords to filter the videos"
          },
          {
            "name": "requireAll",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "description": "Whether to require all keywords"
          },
          {
            "name": "dataTag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Data tag for filtering"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "filteredCount": {
                      "type": "integer"
                    },
                    "originalCount": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "filteredCount": 654,
                  "originalCount": 1035
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/transcripts": {
      "get": {
        "summary": "Get transcripts",
        "description": "Retrieve transcripts based on the video analysis dataTag",
        "parameters": [
          {
            "name": "dataTag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Input tag to filter data",
            "required": true
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100
            },
            "description": "Maximum number of results to return (Max 1000)"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Number of results to skip in order to paginate through results"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transcripts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "channelName": {
                            "type": "string"
                          },
                          "customFields": {
                            "type": "string"
                          },
                          "transcriptRaw": {
                            "type": "string"
                          },
                          "transcriptText": {
                            "type": "string"
                          },
                          "videoId": {
                            "type": "string"
                          },
                          "videoThumbnail": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
